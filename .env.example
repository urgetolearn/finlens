# Local Ollama API forwards gemma4:cloud to Ollama Cloud (sign in with `ollama signin`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:cloud

# Used to decide which RSS stories were published today
TIMEZONE=Asia/Kolkata

# Comma-separated public RSS feeds. Keep source URLs attached to stories.
FINANCIAL_NEWS_FEEDS=https://feeds.bbci.co.uk/news/business/rss.xml,https://www.theguardian.com/business/rss
