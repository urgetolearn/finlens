# Local Ollama API forwards gemma4:cloud to Ollama Cloud (sign in with `ollama signin`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:cloud

# Used to decide which RSS stories were published today
TIMEZONE=Asia/Kolkata

# Comma-separated RSS feeds as region|URL pairs. URL-only entries remain supported as global.
FINANCIAL_NEWS_FEEDS=global|https://feeds.bbci.co.uk/news/business/rss.xml,global|https://www.theguardian.com/business/rss,india|https://www.thehindubusinessline.com/feeder/default.rss,india|https://www.business-standard.com/rss/latest.rss
