# Local Ollama API forwards gemma4:cloud to Ollama Cloud (sign in with `ollama signin`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:cloud

# For hosted deployments, use Ollama's direct Cloud API instead of localhost:
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=gemma4:31b
# OLLAMA_API_KEY=your_ollama_api_key

# Used to decide which RSS stories were published today
TIMEZONE=Asia/Kolkata

# Optional comma-separated list of India-focused RSS feed URLs.
# FINANCIAL_NEWS_FEEDS=https://www.thehindubusinessline.com/markets/feeder/default.rss,https://www.business-standard.com/rss/economy-102.rss
